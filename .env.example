# Neon PostgreSQL 数据库连接字符串
# 去 https://neon.tech 注册，创建项目后获得
DATABASE_URL=postgresql://user:password@ep-xxx.c-xx.region.aws.neon.tech/dbname?sslmode=require

# DeepSeek API Key
# 去 https://platform.deepseek.com 注册并充值
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek 请求地址（可选，默认即可）
DEEPSEEK_BASE_URL=https://api.deepseek.com
