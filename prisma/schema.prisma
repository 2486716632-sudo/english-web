generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Word {
  id           Int          @id @default(autoincrement())
  word         String
  phonetic     String?
  partOfSpeech String
  definition   String
  collocations String?
  example      String?
  exampleZh    String?
  imageUrl     String?
  theme        String?
  difficulty   String       @default("IELTS")
  source       String       @default("built-in")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  reviews      WordReview[]
}

model WordReview {
  id             Int      @id @default(autoincrement())
  word           Word     @relation(fields: [wordId], references: [id])
  wordId         Int
  interval       Int      @default(0)
  easiness       Float    @default(2.5)
  repetitions    Int      @default(0)
  nextReviewAt   DateTime @default(now())
  lastReviewedAt DateTime?
  isMastered     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([wordId])
}

model DailyProgress {
  id              Int      @id @default(autoincrement())
  date            DateTime
  newWordsAdded   Int      @default(0)
  wordsReviewed   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Article {
  id          Int           @id @default(autoincrement())
  title       String
  titleZh     String?
  url         String?
  imageUrl    String?
  source      String
  sourceEmoji String        @default("📰")
  content     String
  summary     String
  summaryEn   String?
  difficulty  Int           @default(3)
  tags        String
  publishedAt DateTime?
  readAt      DateTime?
  favoritedAt DateTime?
  createdAt   DateTime      @default(now())
  vocabItems  ArticleVocab[]
}

model ListeningScene {
  id              String         @id @default(cuid())
  categoryId      String                          // e.g. "scene-campus"
  subcategoryId   String                          // e.g. "campus-lecture"
  title           String                          // e.g. "Surprise Quiz"
  titleZh         String?                          // Chinese translation of title
  description     String?
  difficulty      String         @default("intermediate") // elementary / intermediate / advanced
  duration        Int            @default(0)      // total seconds
  speakers        Int            @default(2)      // number of speakers
  playedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lines           ListeningLine[]

  @@index([categoryId, subcategoryId])
}

model ListeningLine {
  id        String         @id @default(cuid())
  sceneId   String
  speaker   String                          // "A" or "B" or speaker name
  english   String                          // English text
  chinese   String?                          // Chinese translation
  lineOrder Int                             // 0-based line order
  audioUrl  String?                          // path to audio file for this line
  createdAt DateTime       @default(now())
  scene     ListeningScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId, lineOrder])
}

model ArticleVocab {
  id              Int      @id @default(autoincrement())
  articleId       Int
  word            String
  type            String   @default("word")   // word / phrase / expression
  partOfSpeech    String?
  phonetic        String?
  definition      String
  contextSentence String
  example         String?
  exampleZh       String?
  addedToReview   Boolean  @default(false)
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 6 — durable User State + Memory
//
// 最小增量：只新增三张表，不修改任何既有模型/表语义、不迁移既有数据归属。
// 详见 docs/refactor/MEMORY_DESIGN.md 与 docs/refactor/tasks/phase-6-task.md。
// ---------------------------------------------------------------------------

/// 稳定逻辑身份。id 即 UserId（不透明字符串，Domain 只把它当标识）。
model User {
  id        String       @id
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   UserProfile?
  memories  UserMemory[]
}

/// 可变 canonical 学习档案（user state）。与历史性的 UserMemory 刻意分离。
/// 每个字段都必须有真实消费者（参考集成把它们渲染进 learner context 数据段）。
model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  englishLevel        String?
  explanationLanguage String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// durable Memory：有界、结构化、以 (userId, kind, key) 作为去重身份。
/// 刻意不加 importance / confidence / status / embedding：Phase 6 没有它们的消费者。
model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // preference | goal | weakness | milestone
  key       String   // 归一化后的稳定"含义键"
  content   String   // 有界短文本（≤ 500 字符，由 Domain 校验）
  source    String   // explicit_user | deterministic
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, kind])
}
